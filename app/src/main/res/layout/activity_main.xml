<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/primary_blue">

    <!-- 人脸操作覆盖层：相机预览 + 卡片边框 + 底部控制栏。
         始终 INVISIBLE（保持 PreviewView Surface 有效），需人脸时 bringToFront+VISIBLE -->
    <FrameLayout
        android:id="@+id/face_overlay"
        android:layout_width="340dp"
        android:layout_height="540dp"
        android:layout_centerInParent="true"
        android:background="#FF000000"
        android:visibility="invisible">

        <!-- 相机预览：居中 340x480dp -->
        <androidx.camera.view.PreviewView
            android:id="@+id/camera_preview"
            android:layout_width="340dp"
            android:layout_height="480dp"
            android:layout_gravity="center"
            android:scaleType="fitCenter" />

        <!-- 卡片白色边框 -->
        <View
            android:layout_width="340dp"
            android:layout_height="480dp"
            android:layout_gravity="center"
            android:background="@drawable/bg_card_border" />

        <!-- 底部控制栏 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:orientation="vertical"
            android:gravity="center"
            android:paddingHorizontal="32dp"
            android:paddingTop="12dp"
            android:paddingBottom="48dp"
            android:background="#AA000000">

            <TextView
                android:id="@+id/tvFaceStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="请正对摄像头"
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                android:textStyle="bold"
                android:minHeight="40dp" />

            <Button
                android:id="@+id/btnFaceCapture"
                android:layout_width="240dp"
                android:layout_height="48dp"
                android:layout_marginTop="12dp"
                android:text="拍照"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:background="#CC1F76FF" />

            <Button
                android:id="@+id/btnFaceCancel"
                android:layout_width="240dp"
                android:layout_height="48dp"
                android:layout_marginTop="8dp"
                android:text="取消"
                android:textColor="#FFFFFF"
                android:background="#CC333333" />
        </LinearLayout>
    </FrameLayout>

    <FrameLayout
        android:id="@+id/webview_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <RelativeLayout
        android:id="@+id/loading_layout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/primary_blue"
        android:visibility="visible">
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:orientation="vertical"
            android:gravity="center">
            <ProgressBar
                android:id="@+id/progress_bar"
                android:layout_width="50dp"
                android:layout_height="50dp"
                android:indeterminate="true"
                android:indeterminateTint="@color/white" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/loading"
                android:textSize="16sp"
                android:textColor="@color/white"
                android:layout_marginTop="16dp" />
        </LinearLayout>
    </RelativeLayout>

    <RelativeLayout
        android:id="@+id/error_layout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/page_light_blue"
        android:visibility="gone">
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="32dp">
            <TextView android:id="@+id/error_title" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/error_title" android:textSize="20sp" android:textColor="@color/black" android:textStyle="bold" />
            <TextView android:id="@+id/error_message" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/error_unknown" android:textSize="16sp" android:textColor="@color/black" android:layout_marginTop="8dp" />
            <Button android:id="@+id/retry_button" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/btn_retry" android:textSize="16sp" android:layout_marginTop="24dp" android:paddingLeft="32dp" android:paddingRight="32dp" android:paddingTop="12dp" android:paddingBottom="12dp" />
        </LinearLayout>
    </RelativeLayout>
</RelativeLayout>
